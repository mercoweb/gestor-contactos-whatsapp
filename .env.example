# Copia este archivo como .env y ajusta los valores
APP_TOKEN=cambia-este-token-secreto
ADMIN_PASSWORD=cambia-esta-clave
DB_PATH=datos/gestor.db
BASE_URL=http://localhost:8000

# Plantilla de bienvenida. Variables: {nombre} {telefono} {email} {ciudad} {link}
WELCOME_TEMPLATE="¡Hola {nombre}! 👋 Bienvenido/a al grupo. Por favor completa tus datos aquí: {link}"
GOOGLE_FORM_URL=

# Canal por defecto para enviar bienvenidas: bot (whatsapp-web.js) o cloud (API oficial de Meta)
DEFAULT_CHANNEL=bot

# WhatsApp Cloud API (opcional, canal "cloud")
CLOUD_API_PHONE_ID=
CLOUD_API_TOKEN=
CLOUD_API_VERSION=v21.0
